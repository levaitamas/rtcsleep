#!/usr/bin/env bash
# rtcsleep - put the machine to sleep and wake it up via the RTC alarm.
#
# Usage: rtcsleep [-m mem|hibernate|off] [-n] <duration|time|date>
#
#   Duration:  60, 90s, 15m, 2h, 1h30m, 1d12h   (bare number = seconds; units
#                                               d h m s in order, each once)
#   Time:      07:00, 7:30:15, 7am, 6:30pm      (next occurrence, today or tomorrow)
#   Date:      "2026-10-14 07:00", "tomorrow 6:30", anything `date -d` accepts
#
#   -m MODE    mem (suspend-to-RAM, default), hibernate, off (power off)
#   -n         dry run: show what would happen, set no alarm, do not sleep
#
# The RTC alarm is set with `rtcwake -m no`, then the sleep itself goes through
# systemd (systemctl suspend/hibernate/poweroff) so sleep hooks and inhibitor
# locks are honored.

set -euo pipefail

# rtcwake lives in /usr/sbin on Debian/Ubuntu and in /usr/bin on Fedora; look
# for it by path, since /usr/sbin is often not on a normal user's PATH.
RTCWAKE=
for p in /usr/sbin/rtcwake /usr/bin/rtcwake; do
    if [[ -x $p ]]; then RTCWAKE=$p; break; fi
done
SUSPEND_STATS=/sys/power/suspend_stats/success
MIN_LEAD=30            # seconds; entering suspend takes ~15 s (HDD spin-down)
RESUME_TIMEOUT=120     # seconds to wait for suspend to start after systemctl

usage() { sed -n '2,/^$/{/^#/p}' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }
die() { echo "rtcsleep: $*" >&2; exit 1; }
clear_alarm() { "$RTCWAKE" -m disable >/dev/null 2>&1 || true; }

mode=mem dryrun=0
while getopts ":m:nh" opt; do
    case $opt in
        m) mode=$OPTARG ;;
        n) dryrun=1 ;;
        h) usage 0 ;;
        :) die "option -$OPTARG needs an argument" ;;
        *) die "unknown option -$OPTARG (see -h)" ;;
    esac
done
shift $((OPTIND - 1))
[[ $# -ge 1 ]] || usage 1
target="$*"

case $mode in
    mem)       systemctl_verb=suspend ;;
    hibernate) systemctl_verb=hibernate ;;
    off)       systemctl_verb=poweroff ;;
    *) die "invalid mode '$mode' (mem, hibernate, off)" ;;
esac

# Parse a duration like 90, 90s, 15m, 1h30m, 1d12h into seconds; fail otherwise.
# A bare number is only allowed on its own ("1h30" is rejected, not 1h 0m 30s),
# and units must come in d, h, m, s order, each at most once. Returns 2 for
# numbers over 9 digits (leading zeros aside), which could overflow the
# arithmetic.
parse_duration() {
    local s=$1 total=0 i n
    local -a mult=(86400 3600 60 1) parts
    [[ $s =~ ^[0-9]+$ ]] && s+=s
    [[ -n $s && $s =~ ^([0-9]+d)?([0-9]+h)?([0-9]+m)?([0-9]+s)?$ ]] || return 1
    parts=("${BASH_REMATCH[@]:1}")
    for i in 0 1 2 3; do
        n=${parts[i]%?}
        [[ -n $n ]] || continue
        [[ $n =~ ^0*([0-9]+)$ ]] && n=${BASH_REMATCH[1]}
        (( ${#n} <= 9 )) || return 2
        total=$((total + 10#$n * mult[i]))
    done
    echo "$total"
}

# Time of day: 7:30, 07:30:15, or 12-hour 7am, 6:30pm, "7 PM".
time_re='^[0-9]{1,2}(:[0-9]{2}){1,2}$|^[0-9]{1,2}(:[0-9]{2}){0,2} ?[AaPp][Mm]$'

now=$(date +%s)
if secs=$(parse_duration "$target"); then
    wake=$((now + secs))
elif (( $? == 2 )); then
    die "duration '$target' is too long"
elif [[ $target =~ $time_re ]]; then
    TZ=UTC0 date -d "2000-01-01 $target" >/dev/null 2>&1 || die "invalid time '$target'"
    # Use explicit dates: `date -d "tomorrow 02:30"` resolves 02:30 against
    # today, so it fails if today's 02:30 falls into a DST gap. A time that does
    # not exist today (DST gap) moves on to tomorrow.
    today=$(date -d "@$now" +%F)
    wake=$(date -d "$today $target" +%s 2>/dev/null) || wake=0
    if (( wake <= now + MIN_LEAD )); then
        tomorrow=$(date -d "$today 12:00 +1 day" +%F)
        wake=$(date -d "$tomorrow $target" +%s 2>/dev/null) ||
            die "time '$target' does not exist tomorrow (DST change)"
    fi
elif [[ $target =~ ^[0-9]+[[:alnum:]]*$ ]]; then
    # e.g. "1x", "1h30": not valid durations, but `date -d` would accept them
    die "invalid duration '$target' (e.g. 90, 15m, 1h30m, 1d12h)"
else
    wake=$(date -d "$target" +%s 2>/dev/null) || die "cannot parse '$target'"
fi

lead=$((wake - now))
wake_str=$(date -d "@$wake" '+%a %F %T %Z')
(( lead > 0 )) || die "wake time $wake_str is in the past"
(( lead >= MIN_LEAD )) || die "wake time $wake_str is less than ${MIN_LEAD}s from now"

# Fail before asking for a sudo password; a dry run does not need rtcwake.
(( dryrun )) || [[ -n $RTCWAKE ]] ||
    die "rtcwake not found in /usr/sbin or /usr/bin (install util-linux)"

# Everything below needs root; re-exec through sudo with the resolved timestamp
# so the wake time does not drift while waiting for a password.
if (( !dryrun && EUID != 0 )); then
    exec sudo "$0" -m "$mode" "@$wake"
fi

printf 'Mode:   %s\nWake:   %s (in %dh %02dm %02ds)\n' "$mode" "$wake_str" \
    $((lead / 3600)) $((lead % 3600 / 60)) $((lead % 60))

if (( dryrun )); then
    echo "Dry run: no alarm set, not sleeping."
    exit 0
fi

# Read the suspend counter before arming the alarm, so a failure here cannot
# leave an alarm set behind. Only suspend-to-RAM waits for the resume.
if [[ $mode == mem ]]; then
    before=$(cat "$SUSPEND_STATS" 2>/dev/null) || die "cannot read $SUSPEND_STATS"
fi

# From here on, any exit clears the alarm: errors, Ctrl-C, kill, and also the
# normal exit after resuming from suspend, since something else (keyboard, lid,
# network) may have woken the machine before the alarm fired.
trap clear_alarm EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

"$RTCWAKE" -m no -t "$wake" >/dev/null || die "failed to set RTC alarm"

# Hibernate and poweroff need the alarm to wake up again. Stop clearing it on
# exit before calling systemctl: the shutdown may signal or kill this script
# (or systemctl) at any point from here on.
if [[ $mode != mem ]]; then
    trap - EXIT
    systemctl "$systemctl_verb" && exit 0
    rc=$?
    # Killed by a signal: most likely by the shutdown itself, which needs the alarm.
    (( rc > 128 )) && die "systemctl $systemctl_verb was killed; RTC alarm left set"
    clear_alarm
    die "systemctl $systemctl_verb failed; RTC alarm cleared"
fi

systemctl "$systemctl_verb" || die "systemctl $systemctl_verb failed; RTC alarm cleared"

# systemctl returns before the machine actually sleeps; wait for the resume.
# The loop does not run while suspended, so `waited` counts awake time only.
# A failed read counts as "not resumed yet"; mistaking it for a resume would
# clear the alarm while the machine may still be about to suspend.
waited=0
while :; do
    count=$(cat "$SUSPEND_STATS" 2>/dev/null) || count=$before
    [[ $count == "$before" ]] || break
    sleep 1
    if (( ++waited >= RESUME_TIMEOUT )); then
        die "system did not go to sleep within ${RESUME_TIMEOUT}s; RTC alarm cleared"
    fi
done
echo "Woke:   $(date '+%a %F %T %Z') (slept ~$(( $(date +%s) - now ))s incl. suspend/resume)"
